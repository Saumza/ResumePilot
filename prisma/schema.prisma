// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  email             String             @unique @db.VarChar(50)
  password          String?
  emailVerified     Boolean            @default(false)
  refreshToken      String?
  skills            Skill[]
  experiences       Experience[]
  githubUrl         String?
  linkdinUrl        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  education         Education[]
  savedJobs         SavedJobs[]
  applications      Application[]
  normalResumes     NormalResume[]
  aiTailoredResumes AiTailoredResume[]
  coverLetters      CoverLetter[]
}

model Skill {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  skillName String    @db.VarChar(20)
  skillType SkillType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum SkillType {
  Framework
  Languages
  Platfrom
  Tool
  Domain
}

model Experience {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @db.Uuid
  user                   User                    @relation(fields: [userId], references: [id])
  companyName            String                  @db.VarChar(50)
  title                  String                  @db.VarChar(40)
  experienceDescriptions ExperienceDescription[]
  employmentType         EmploymentType
  startDate              DateTime
  endDate                DateTime?
  isCurrent              Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model ExperienceDescription {
  id              String     @id @default(uuid()) @db.Uuid
  experienceId    String     @db.Uuid
  experience      Experience @relation(fields: [experienceId], references: [id])
  descriptionText String     @db.VarBit(300)
  displayOrder    Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum EmploymentType {
  Fulltime
  Parttime
  Contract
  Internship
}

model Education {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  instituition String    @db.VarChar(50)
  degree       String    @db.VarChar(30)
  fieldOfStudy String    @db.VarChar(30)
  grade        String?
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Job {
  id                String             @id @default(uuid()) @db.Uuid
  externalJobId     String             
  companyName       String             @db.VarChar(50)
  title             String             @db.VarChar(30)
  description       Json
  location          String             @db.VarChar(100)
  sourceUrl         String
  jobType           JobType
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  savedJobs         SavedJobs[]
  applications      Application[]
  aiTailoredResumes AiTailoredResume[]
  coverLetters      CoverLetter[]
}

enum JobType {
  Onsite
  Hybrid
  Remote
}

model SavedJobs {
  id               String   @id @default(uuid()) @db.Uuid
  jobId            String   @db.Uuid
  job              Job      @relation(fields: [jobId], references: [id])
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id])
  isResumeTailored Boolean  @default(false)
  savedAt          DateTime @default(now())
}

model Application {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  user             User             @relation(fields: [userId], references: [id])
  jobId            String           @db.Uuid
  job              Job              @relation(fields: [jobId], references: [id])
  status           Status
  resumeId         String           @db.Uuid
  aiTailoredResume AiTailoredResume @relation(fields: [resumeId], references: [id])
  coverLetterId    String           @db.Uuid
  coverLetter      CoverLetter      @relation(fields: [coverLetterId], references: [id])
  appliedAt        DateTime         @default(now())
}

enum Status {
  Applied
  Interview
  Offer
  Close
}

model NormalResume {
  id                String             @id @default(uuid()) @db.Uuid
  name              String?
  ownerId           String             @db.Uuid
  user              User               @relation(fields: [ownerId], references: [id])
  rawText           String             @db.VarChar(600)
  resumeUrl         String
  aiReviewed        Boolean            @default(false)
  aiInsights        Json?
  atsScore          Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aiTailoredResumes AiTailoredResume[]
}

model AiTailoredResume {
  id               String        @id @default(uuid()) @db.Uuid
  name             String?       @db.VarChar(20)
  ownerId          String        @db.Uuid
  user             User          @relation(fields: [ownerId], references: [id])
  jobId            String        @db.Uuid
  job              Job           @relation(fields: [jobId], references: [id])
  originalResumeId String        @db.Uuid
  normalResume     NormalResume  @relation(fields: [originalResumeId], references: [id])
  resumeUrl        String
  aiInsights       Json?
  atsScore         Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  applications     Application[]
}

model CoverLetter {
  id             String        @id @default(uuid()) @db.Uuid
  ownerId        String        @db.Uuid
  user           User          @relation(fields: [ownerId], references: [id])
  jobId          String        @db.Uuid
  job            Job           @relation(fields: [jobId], references: [id])
  coverLetterUrl String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]
}
