// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  email             String             @unique @db.VarChar(50)
  password          String?
  emailVerified     DateTime?
  isOnboarded       Boolean            @default(false)
  refreshToken      String?
  image             String?
  linkdinUrl        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  skills            Skill[]
  experiences       Experience[]
  education         Education[]
  savedJobs         SavedJobs[]
  applications      Application[]
  normalResumes     NormalResume[]
  aiTailoredResumes AiTailoredResume[]
  coverLetters      CoverLetter[]
  accounts          Account[]
  sessions          Session[]
  githubs           Github[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Github {
  id               String   @id @default(uuid())
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username         String
  url              String
  totalPublicRepos Int
  totalStars       Int
  totalLanguages   Int
  languages        Json
  repositories     Json
  lastSyncedAt     DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Skill {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  skillName String    @db.VarChar(20)
  skillType SkillType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum SkillType {
  Language
  Framework
  Tool
  Platform
  Domain
}

model Experience {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id])
  companyName    String         @db.VarChar(50)
  title          String         @db.VarChar(40)
  employmentType EmploymentType
  description    Json
  startDate      Int
  endDate        String?
  isCurrent      Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum EmploymentType {
  Fulltime
  Parttime
  Contract
  Internship
}

model Education {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  instituition String    @db.VarChar(50)
  degree       String    @db.VarChar(30)
  fieldOfStudy String    @db.VarChar(30)
  grade        String?
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Job {
  id                String             @id @default(uuid()) @db.Uuid
  externalJobId     String
  companyName       String             @db.VarChar(50)
  title             String             @db.VarChar(30)
  description       Json
  location          String             @db.VarChar(100)
  sourceUrl         String
  jobType           JobType
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  savedJobs         SavedJobs[]
  applications      Application[]
  aiTailoredResumes AiTailoredResume[]
  coverLetters      CoverLetter[]
}

enum JobType {
  Onsite
  Hybrid
  Remote
}

model SavedJobs {
  id               String   @id @default(uuid()) @db.Uuid
  jobId            String   @db.Uuid
  job              Job      @relation(fields: [jobId], references: [id])
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id])
  isResumeTailored Boolean  @default(false)
  savedAt          DateTime @default(now())
}

model Application {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  user             User              @relation(fields: [userId], references: [id])
  jobId            String            @db.Uuid
  job              Job               @relation(fields: [jobId], references: [id])
  companyName      String
  jobRole          String
  jobUrl           String?
  status           Status
  resumeId         String?           @db.Uuid
  aiTailoredResume AiTailoredResume? @relation(fields: [resumeId], references: [id])
  coverLetterId    String?           @db.Uuid
  coverLetter      CoverLetter?      @relation(fields: [coverLetterId], references: [id])
  appliedAt        DateTime          @default(now())
}

enum Status {
  Applied
  Interview
  Offer
  Close
}

model NormalResume {
  id                String             @id @default(uuid()) @db.Uuid
  name              String?
  ownerId           String             @db.Uuid
  user              User               @relation(fields: [ownerId], references: [id])
  resumeText        Json
  rawText           String             @db.Text
  resumeUrl         String
  publicId          String             @unique
  aiReviewed        Boolean            @default(false)
  aiInsights        Json?
  atsScore          Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aiTailoredResumes AiTailoredResume[]
}

model AiTailoredResume {
  id               String        @id @default(uuid()) @db.Uuid
  name             String?       @db.VarChar(20)
  ownerId          String        @db.Uuid
  user             User          @relation(fields: [ownerId], references: [id])
  jobId            String?       @db.Uuid
  job              Job?          @relation(fields: [jobId], references: [id])
  jobDescription   String?
  originalResumeId String        @db.Uuid
  normalResume     NormalResume  @relation(fields: [originalResumeId], references: [id], onDelete: Cascade)
  resumeData       Json
  aiInsights       Json?
  atsScore         Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  applications     Application[]
}

model CoverLetter {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @db.Uuid
  user            User          @relation(fields: [ownerId], references: [id])
  jobId           String?       @db.Uuid
  job             Job?          @relation(fields: [jobId], references: [id])
  name            String?
  jobDescription  String?
  coverLetterData Json
  aiInsights      Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
}
